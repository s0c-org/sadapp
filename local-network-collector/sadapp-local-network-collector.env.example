CONTROL_PLANE_URL=https://sadapp.org/
ENROLLMENT_TOKEN=
# ACTOR_ID and ACTOR_SECRET are alternatives to enrollment/persisted credentials.
ACTOR_ID=
ACTOR_SECRET=
STATE_DIR=/var/lib/sadapp-local-network-collector
HEARTBEAT_INTERVAL_SECONDS=30
MAX_CONCURRENT_TASKS=4
SPOOL_MAX_ITEMS=10000
SPOOL_MAX_BYTES=67108864
# Optional loopback-only health endpoint.
HEALTH_PORT=9168
RUST_LOG=info