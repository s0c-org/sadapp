[Unit]
Description=SadApp Local Network Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RUST_LOG=info
EnvironmentFile=-/etc/default/sadapp-local-network-collector
ExecStart=/usr/bin/sadapp-local-network-collector
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sadapp-local-network-collector
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=sadapp-local-network-collector
StateDirectoryMode=0700
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target