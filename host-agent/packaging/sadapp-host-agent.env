# Configure credentials before starting the service.
API_ENDPOINT=https://sadapp.org/api/v1/agent
API_INVITE_TOKEN=
API_KEY_ID=
API_KEY_SECRET=
API_INTERVAL_SECONDS=30
# Docker, disk, network, and logs run outside the heartbeat on this cadence.
API_MEDIUM_COLLECTOR_INTERVAL_SECONDS=120
# Optional Docker Engine Unix socket. The agent requires socket access to inspect containers.
DOCKER_HOST=unix:///var/run/docker.sock
# SMART and package update checks run outside the heartbeat on this cadence.
API_SLOW_COLLECTOR_INTERVAL_SECONDS=3600
# Package updates are verified by the configured signed APT/RPM repository.
API_UPDATE_CHANNEL=stable
API_DESIRED_AGENT_VERSION=
API_UPDATE_STATE_PATH=/var/lib/sadapp-host-agent/update-state.json
# Failed heartbeats are stored with mode 0600 and replayed oldest first.
API_QUEUE_PATH=/var/lib/sadapp-host-agent/telemetry-queue.json
API_QUEUE_MAX_SAMPLES=200